@model SampleForm
@*SampleFormとバインディングしている*@
@{
    ViewData["Title"] = "HTML Formを生成するタグヘルパー";
}
<h2>@ViewData["Title"]</h2>
@*
   使用するコントローラ:TagHelperFormController
   実行するアクションメソッド:Confirm()メソッド
*@
@*
   FormSample(asp-controller)のResult(asp-action)にいってねの意
*@
<form asp-controller="FormSample" asp-action="Result" method="post">
    @Html.AntiForgeryToken() @* CSRFトークンの生成 *@
    @* SampleFormのNameプロパティにバインドされる *@
    @* inputの名前と連動(Displayで表示)*@
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    @* SampleFormのAgeプロパティにバインドされる *@
    <label asp-for="Age" class="form-label"></label>
    <input asp-for="Age" class="form-control" />
    @* SampleFormのPrefecturesIdプロパティにバインドされる *@
    <label asp-for="PrefecturesId" class="form-label"></label>
    @* SampleFormのPrefecturesListにバインドされる *@
    @* <select>要素生成タグヘルパー, 選択できる*@
    @* Model.:ViewModelのインスタンス *@
    <select asp-for="PrefecturesId" asp-items="Model.PrefecturesList" class="form-control"></select>
    @* [送信]ボタン *@
    <br />
    <div class="d-flex justify-content-center">
        <button type="submit">送信</button>
    </div>
</form>