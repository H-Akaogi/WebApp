@*計算画面*@

@*Razor Viewで名前空間をインポートする*@
@using WebApp_Op03.Models

@* Viewに渡すデータ型を宣言する*@
@model Op03Form

@*タイトル表示*@
@*ViewData "Title" というキーに文字列を格納*@
@{
    ViewData["Title"] = "演習option04";
}

@*さっき入れた値を取得しHTMLに表示*@
<h2>@ViewData["Title"]</h2>


<div class="d-flex justify-content-center">
    @*asp-controllerの値はControllerの[Route]と揃える*@
    @*asp-actionの値はControllerの[HttpGet/Post]と揃える*@
    <form asp-controller="Option04" asp-action="Result" method="post">

        @*HTMLヘルパーメソッド*@
        @*フォーム送信時にCSRFトークン(@Html.AntiForgeryToken) を自動挿入*@
        @Html.AntiForgeryToken()

        @*値1の入力*@
        <div class="mb-3">
            @*label asp-for：対応する入力項目のラベルを自動生成*@
            <label asp-for="Value1" class="form-label"></label>
            @*input asp-for:プロパティの型に応じてinputのtypeが自動決定される*@
            <input asp-for="Value1" class="form-control"></label>
            @*
            指定フィールドのバリデーションメッセージ出力
            text-danger: Bootstrapのクラス、赤文字で表示するためのスタイル
            Value1 に対応する ModelState のエラーを自動表示する
            *@
            <span asp-validation-for="Value1" class="text-danger"></span>
        </div>

        @*値2の入力*@
        <div class="mb-3">
            @*label asp-for：対応する入力項目のラベルを自動生成*@
            <label asp-for="Value2" class="form-label"></label>
            @*input asp-for:プロパティの型に応じてinputのtypeが自動決定される*@
            <input asp-for="Value2" class="form-control"></label>
            @*
            指定フィールドのバリデーションメッセージ出力
            text-danger: Bootstrapのクラス、赤文字で表示するためのスタイル
            Value2 に対応する ModelState のエラーを自動表示する
            *@
            <span asp-validation-for="Value2" class="text-danger"></span>
        </div>

        @*計算の種類の入力*@
        <div class="mb-3">
            @* SampleFormのAgeプロパティにバインドされる *@
            @*label asp-for：対応する入力項目のラベルを自動生成*@
            <label asp-for="Opt" class="form-label"></label>
            @*input asp-for:プロパティの型に応じてinputのtypeが自動決定される*@
            <input asp-for="Opt" class="form-control" />
        </div>

        @*ボタン*@
        <div class="text-center">
            @*
            <button type="submit">：フォーム送信ボタン
            ・押すと <form> の内容がサーバーへ送信される
            ・MVCでは通常 POST アクションが呼ばれる

            class="btn btn-primary"：Bootstrapのスタイル
            ・btn → ボタンとしての基本スタイル
            ・btn-primary → 青いメインボタン

            text-center
            ・中央揃え
            ・この div の中身（ボタン）が横中央に配置される
            *@
            <button type="submit" class="btn btn-primary">計算</button>
        </div>
    </form>
</div>